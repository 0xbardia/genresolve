# ---------------------------------------------------------------------------
# GenResolve — network contract addresses (placeholders only)
# Copy to .env.local and set real addresses after Studio deploy.
# Never commit .env.local.
# ---------------------------------------------------------------------------

# Studionet (Chain ID 61999, RPC https://studio.genlayer.com/api)
NEXT_PUBLIC_CONTRACT_ADDRESS_STUDIONET=0xYourStudionetContractAddress

# Bradbury Testnet (Chain ID 4221, RPC https://rpc-bradbury.genlayer.com)
NEXT_PUBLIC_CONTRACT_ADDRESS_BRADBURY=0xYourBradburyContractAddress

# Optional: default network on first load ("studionet" | "bradbury")
NEXT_PUBLIC_DEFAULT_NETWORK=studionet

# ---------------------------------------------------------------------------
# Evidence Assist (optional, OFF by default — enable only after security review)
# Server flag and public UI flag should match in staging/prod.
# ---------------------------------------------------------------------------
ENABLE_EVIDENCE_ASSIST=false
NEXT_PUBLIC_ENABLE_EVIDENCE_ASSIST=false
# ASSIST_EXA_API_KEY=          # server-only; required for discover without URL
# ASSIST_MAX_SOURCES=3
# ASSIST_TIMEOUT_MS=20000
# ASSIST_CACHE_TTL_SEC=300
# ASSIST_ALLOWED_HOSTS=        # optional comma-separated host allowlist
# ASSIST_IP_LIMIT=10
# ASSIST_IP_WINDOW_MS=600000

